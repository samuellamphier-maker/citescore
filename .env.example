# ── Marketing / checkout ──────────────────────────────────────────
# Stripe Payment Link URL. Inlined at build time.
# CiteScore appends client_reference_id + site_url (the audited URL).
NEXT_PUBLIC_CHECKOUT_URL=

# Canonical site URL used in emails and report links.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
# APP_URL=https://your-domain.com
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Stripe fulfillment ────────────────────────────────────────────
# Webhook signing secret from Stripe → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=

# Optional. Used only to re-fetch a Checkout Session if the webhook
# payload is missing email or URL. Webhook verify works without it.
# STRIPE_SECRET_KEY=

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
# e.g. CiteScore <reports@your-domain.com>  (domain must be verified)
EMAIL_FROM=

# ── LLM scoring (at least one) ────────────────────────────────────
# OpenAI is used when set; otherwise Anthropic.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Job store ─────────────────────────────────────────────────────
# Prefer Supabase in production (durable across Vercel instances).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# File-store overrides (used when Supabase is unset).
# Local default: data/jobs.json
# Vercel default: /tmp/citescore-jobs.json (ephemeral — not for production)
# JOBS_PATH=
# WAITLIST_PATH=

# ── Admin / cron ──────────────────────────────────────────────────
# Required for /admin, GET/POST /api/jobs, and retries.
ADMIN_TOKEN=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET
# CRON_SECRET=
