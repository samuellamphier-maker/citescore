# Stripe Payment Link or Lemon Squeezy overlay/share URL.
# When set, /checkout shows a "Continue to payment" button.
# The audited URL is appended as ?site_url=
# Leave unset for the waitlist capture state.
NEXT_PUBLIC_CHECKOUT_URL=

# Optional. Absolute path for waitlist JSON.
# Local default: data/waitlist.json
# Vercel default: /tmp/citescore-waitlist.json (ephemeral)
# WAITLIST_PATH=
